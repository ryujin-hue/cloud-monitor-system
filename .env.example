# ---------------------------------------------------------------------------
# Backend configuration for local development.
#
# Copy to `.env` (gitignored) and fill in the real values. The Android apps read their
# backend URL from the `BACKEND_BASE_URL` build configuration, not from this file.
# ---------------------------------------------------------------------------

# The public URL of the deployed Pages project, e.g. https://cloud-monitor-api.pages.dev
BACKEND_BASE_URL=https://cloud-monitor-api.pages.dev

# Key used by Cloud Monitor for POST /api/event and POST /api/heartbeat.
MONITOR_API_KEY=replace-me-with-a-long-random-monitor-key

# Key used by Cloud Alert for GET /api/status, GET /api/events and POST /api/register.
# It MUST be different from MONITOR_API_KEY.
ALERT_API_KEY=replace-me-with-a-different-long-random-alert-key

# Comma separated browser origins allowed to call the API.
ALLOWED_ORIGINS=

# Set to "false" to disable push delivery while bootstrapping.
PUSH_ENABLED=true

# Path to the Firebase service account JSON (kept outside the repository).
FCM_SERVICE_ACCOUNT_JSON_PATH=/secure/path/firebase-service-account.json
